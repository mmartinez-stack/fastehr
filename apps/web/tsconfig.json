{
  "extends": "@fastehr/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "module": "ESNext",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Everything the app owns lives under src/, so `@/*` has exactly one root.
    // An earlier split layout needed a second root here, and `tsc` and
    // Turbopack disagreed about how to resolve it — a bare directory present in
    // both roots type-checked and then rendered as undefined. One root, no
    // ambiguity.
    "paths": {
      "@/*": ["./src/*"]
    },
    // TODO: re-enable once src/lib/mock-data.ts is replaced by @fastehr/db.
    // The generated mockup indexes fixture arrays unchecked in ~30 places;
    // the flag stays on for every package under packages/.
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo"]
}

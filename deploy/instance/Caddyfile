# TLS termination in front of the app. Caddy obtains and renews the
# Let's Encrypt certificate on its own; it needs the Route53 record to resolve
# to this box and port 80 reachable for the HTTP-01 challenge (the web stack
# opens both).
#
# No `log` directive on purpose. An access log records request paths, and the
# intake link carries its single-use token in the path (ADR 29: the token
# exists in the text message and the URL, nowhere else). Caddy's own runtime
# messages still reach the container's stdout.
{$APP_HOST} {
	encode zstd gzip

	tls {
		protocols tls1.2 tls1.3
	}

	# Larger than any form here and far above the partner API's own 16 KiB cap
	# (ADR 38); stops a stray upload from reaching the app at all.
	request_body {
		max_size 256KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy web:3000 {
		# tRPC's httpBatchStreamLink (ADR 17) and RSC both stream: flush every
		# chunk as it arrives rather than buffering the response.
		flush_interval -1

		# Overwrite, never append: the partner API's key allowlist and the
		# audit trail's address column read X-Forwarded-For (ADR 38), and an
		# appended header would carry whatever the caller chose to send.
		header_up X-Forwarded-For {remote_host}

		transport http {
			response_header_timeout 30s
		}
	}
}

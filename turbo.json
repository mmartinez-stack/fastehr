{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "globalDependencies": ["pnpm-lock.yaml", ".nvmrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "DATABASE_URL"]
    },
    "typecheck": { "dependsOn": ["^generate", "generate"] },
    "lint": { "dependsOn": ["^generate", "generate"] },
    "test": { "dependsOn": ["^generate", "generate"], "outputs": ["coverage/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}

# The build context is the repository root (see Dockerfile), so this file is
# what keeps that from meaning "everything, including 900 MB of node_modules".
#
# Deny nothing by default and exclude deliberately: a missed entry here costs
# build time and cache invalidation, while an over-broad one silently omits
# source and fails the build — which is the safer direction.

# Installed per-stage inside the image, never copied in.
node_modules/
**/node_modules/

# Build output and caches — regenerated in the build stage. Copying a host
# .next/ in would also risk shipping a build made with another environment's
# inlined NEXT_PUBLIC_* values.
.next/
**/.next/
.turbo/
**/.turbo/
dist/
**/dist/
**/*.tsbuildinfo

# Generated Prisma client: the build stage runs `prisma generate` itself, and a
# copy from the host could be stale relative to schema.prisma.
packages/db/src/generated/

# Secrets. `.env.example` is intentionally not excluded — it documents the
# contract and contains no values.
.env
.env.*
!.env.example

# Not needed to build or run the server.
.git/
.github/
.gitignore
docs/
README.md
**/*.md
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts
**/vitest.config.ts
**/vitest.*.config.ts
packages/db/test/
coverage/
**/coverage/

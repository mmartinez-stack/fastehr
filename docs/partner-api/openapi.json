{
  "openapi": "3.1.0",
  "info": {
    "title": "FastEHR Partner API",
    "version": "1.0.0",
    "description": "Server-to-server API for approved partners. Every request carries a partner key as a Bearer token; patient-specific calls also carry a verification token obtained from the verify operation. Errors are codes, never messages. Responses are never cached."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "patients",
      "description": "Lookup and verification"
    },
    {
      "name": "queue",
      "description": "The live clinic queue"
    }
  ],
  "paths": {
    "/patients/lookup": {
      "post": {
        "operationId": "patients.lookup",
        "tags": [
          "patients"
        ],
        "summary": "Find a patient",
        "description": "Returns up to five candidates matching the identifiers given. No date of birth is ever returned: it is a verification factor.",
        "security": [
          {
            "bearerKey": [
              "patients:lookup"
            ]
          }
        ],
        "x-scope": "patients:lookup",
        "x-requires-verification": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientLookupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientLookupResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "unsupported_media_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patientId}/verify": {
      "post": {
        "operationId": "patients.verify",
        "tags": [
          "patients"
        ],
        "summary": "Verify the caller as a patient",
        "description": "Checks the date of birth and phone against the record. On success returns a verification token, valid fifteen minutes, that every patient-specific call must present. Failures do not say which factor was wrong; repeated failures lock the patient out.",
        "security": [
          {
            "bearerKey": [
              "patients:verify"
            ]
          }
        ],
        "x-scope": "patients:verify",
        "x-requires-verification": false,
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientVerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "forbidden | verification_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "unsupported_media_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited | verification_locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/queue/count": {
      "get": {
        "operationId": "queue.count",
        "tags": [
          "queue"
        ],
        "summary": "Live clinic queue count",
        "description": "How many patients are waiting to be seen, per clinic. The count is exact once the front desk records arrivals on the queue screen; until then it is zero.",
        "security": [
          {
            "bearerKey": [
              "queue:read"
            ]
          }
        ],
        "x-scope": "queue:read",
        "x-requires-verification": false,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": {
              "default": "all",
              "description": "A clinic slug, or \"all\" (the default) for every active clinic.",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "sylmar",
                    "kanoga",
                    "montebello"
                  ]
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueCountResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A partner API key. Scopes: patients:lookup, patients:verify, medications:read, refills:write, tasks:write, queue:read, appointments:read, appointments:write, interactions:write."
      }
    },
    "parameters": {
      "PatientVerification": {
        "name": "x-patient-verification",
        "in": "header",
        "required": true,
        "description": "The verification token issued by the verify operation for this patient.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "PatientLookupRequest": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "YYYY-MM-DD"
          },
          "phone": {
            "description": "Ten digits. Punctuation and a leading 1 are stripped.",
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "additionalProperties": false,
        "description": "Either patientId alone, or dateOfBirth with phone and/or lastName (firstName narrows a lastName)."
      },
      "PatientVerifyRequest": {
        "type": "object",
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "YYYY-MM-DD"
          },
          "phone": {
            "description": "Ten digits. Punctuation and a leading 1 are stripped.",
            "type": "string"
          }
        },
        "required": [
          "dateOfBirth",
          "phone"
        ],
        "additionalProperties": false,
        "description": "Both factors, exactly as the patient states them."
      },
      "PatientLookupResponse": {
        "type": "object",
        "properties": {
          "candidates": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PatientCandidate"
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "candidates",
          "truncated"
        ],
        "additionalProperties": false
      },
      "PatientVerifyResponse": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean",
            "const": true
          },
          "verificationToken": {
            "type": "string",
            "minLength": 16
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "verified",
          "verificationToken",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "QueueCountResponse": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sylmar",
                  "kanoga",
                  "montebello"
                ]
              },
              {
                "type": "string",
                "const": "all"
              }
            ]
          },
          "waiting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "longestWaitMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "byLocation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueLocationCount"
            }
          }
        },
        "required": [
          "asOf",
          "location",
          "waiting",
          "longestWaitMinutes",
          "byLocation"
        ],
        "additionalProperties": false
      },
      "PatientCandidate": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phoneLast4": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "locationId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sylmar",
                  "kanoga",
                  "montebello"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "patientId",
          "firstName",
          "lastName",
          "phoneLast4",
          "locationId"
        ],
        "additionalProperties": false
      },
      "QueueLocationCount": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "sylmar",
              "kanoga",
              "montebello"
            ]
          },
          "waiting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "longestWaitMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "location",
          "waiting",
          "longestWaitMinutes"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "unauthenticated",
                  "forbidden",
                  "verification_required",
                  "verification_failed",
                  "not_found",
                  "method_not_allowed",
                  "conflict",
                  "idempotency_mismatch",
                  "payload_too_large",
                  "unsupported_media_type",
                  "rate_limited",
                  "verification_locked",
                  "internal_error"
                ]
              },
              "requestId": {
                "type": "string"
              },
              "validation": {
                "type": "object",
                "properties": {
                  "fieldErrors": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "formErrors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "fieldErrors",
                  "formErrors"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "code",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}

# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# Loaded by:
#   - the Prisma CLI, via `dotenv/config` in packages/db/prisma.config.ts
#   - your process manager / host at runtime
#
# Nothing here is needed to `pnpm install`, `pnpm turbo run build`, or run CI:
# `prisma generate` takes no connection, and no test opens one yet. A value is
# required the first time a query runs, and for `prisma migrate`.

# PostgreSQL connection string. Validated by @fastehr/contracts at first query
# — it must start with postgresql:// or postgres://.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastehr"

# Optional. Absolute origin used by the tRPC link only when a Client Component
# queries during SSR without prefetched data — in the browser the link is
# relative and this is unused. Defaults to http://localhost:3000.
# Inlined at build time (NEXT_PUBLIC_*), so it is part of the build cache key.
# NEXT_PUBLIC_APP_URL="https://app.example.com"

# Integration tests only. Must be a scratch database — the suite truncates
# tables between cases and deliberately refuses to fall back to DATABASE_URL.
#   docker run -d --rm -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fastehr_test \
#     -p 55432:5432 postgres:17-alpine
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/fastehr_test"

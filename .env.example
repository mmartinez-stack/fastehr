# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# Loaded by:
#   - the Prisma CLI, via `dotenv/config` in packages/db/prisma.config.ts
#   - your process manager / host at runtime
#
# Nothing here is needed to `pnpm install`, `pnpm turbo run build`, or run CI:
# `prisma generate` takes no connection, and no test opens one yet. A value is
# required the first time a query runs, and for `prisma migrate`.

# PostgreSQL connection string. Validated by @fastehr/contracts at first query
# — it must start with postgresql:// or postgres://.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastehr"

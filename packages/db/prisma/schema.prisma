// Placeholder schema. The real model set lands with the persistence ticket —
// one model is enough to prove `prisma generate` runs and is cacheable.
//
// `output` points INSIDE the package (packages/db/src/generated) so Turborepo
// can treat the generated client as a declared task output and cache it. Under
// the `prisma-client` generator that is also the only option: Prisma 7 requires
// `output` and no longer writes into node_modules.
//
// The generator emits ESM TypeScript source, which is exactly what a JIT
// package consumes (ADR 1) — there is no Rust engine binary and no runtime
// filesystem probe, so Next.js has nothing to over-trace.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// `url` is no longer permitted here in Prisma 7 (P1012). Connection URLs for
// the CLI live in prisma.config.ts; the runtime gets its connection from the pg
// driver adapter in src/index.ts.
datasource db {
  provider = "postgresql"
}

// Enumerations the legacy schema itself enforced — safe as native PG enums.
// The pick-list fields the legacy schema left as free strings (office,
// referralSource, programType) stay String here so imported historical values
// survive; the *inputs* constrain them to the current lists
// (@fastehr/contracts).

enum PatientGender {
  male
  female

  @@map("patient_gender")
}

enum PatientLanguage {
  english
  spanish

  @@map("patient_language")
}

enum PatientStatus {
  active
  inactive

  @@map("patient_status")
}

model Patient {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  // `@db.Date` is a calendar date with no time and no zone, which is what a
  // date of birth is. Prisma still surfaces it as a JS `Date` at UTC midnight —
  // the mapper converts it to the `YYYY-MM-DD` string the contract declares.
  // That conversion is the boundary ADR 3 describes, made concrete.
  dateOfBirth DateTime @db.Date

  // Demographics from the legacy patient form. Required on the form but
  // nullable here: records imported from the legacy collection predate the
  // form's validators and may lack any of them.
  gender   PatientGender?
  language PatientLanguage?
  office   String?

  // --- Clinical sections (DIA-52). The record is one row plus three child
  // tables; which sections a caller may read or write is decided per role in
  // the server layer, not here. ---

  // Vitals. Total inches, as the legacy form captured it; the form shows feet
  // and inches and composes them, so migrated heights are untouched. (Healthy
  // weight was dropped with DIA-52: nothing read it.)
  heightInches Float?
  medications  PatientMedication[]
  allergies    PatientAllergy[]
  conditions   PatientCondition[]
  // Medical history, "Other": free text at the end of the checklist. Holds
  // the legacy `hx` ("current medications and pertinent history") verbatim —
  // the column was renamed, never parsed, so nothing was lost.
  historyOther String?
  // Primary care doctor.
  pcpName    String?
  pcpAddress String?
  pcpPhone   String?

  // Optional contact details. Stored normalized (lowercase email, ten bare
  // digits) — `createPatientInput` in @fastehr/contracts is the single place
  // that normalization is defined.
  email String?
  phone String?
  // Legacy `phone.permission` — the follow-up consent flag the call lists key on.
  phoneFollowUpAllowed Boolean @default(true)

  addressStreet String?
  addressCity   String?
  addressState  String?
  addressZip    String?

  // Referral provenance. The self-relation replaces the legacy `referredByPt`
  // ObjectId; the legacy referral-credit bookkeeping (`referrals[].used`) is a
  // campaign feature and deliberately not modelled.
  referralSource      String?
  referredByPatientId String?
  referredByPatient   Patient?  @relation("PatientReferrals", fields: [referredByPatientId], references: [id])
  referrals           Patient[] @relation("PatientReferrals")

  programType String?

  // Kept in the schema, no longer exposed: the Aug 31 sync replaced the
  // active/inactive badge with the last-visit date (DIA-50). Nothing renders
  // or filters on it; the column stays so no migrated value is lost.
  status PatientStatus @default(active)

  // Denormalized `max(visits.dateOfService)` — the legacy `recentVisit`,
  // which its visit hooks maintained the same way. It is what the roster sorts
  // by and what the over-a-year flag reads, so it is a column rather than a
  // per-row aggregate over a 50k-row table. Written by the visits import and
  // by every visit write; never by the patient form.
  lastVisitAt DateTime?
  visits      Visit[]
  intakes     IntakeRequest[]

  // The provisional credit-card block (contracts § patient header comment):
  // the fields the legacy form rendered, carried for billing continuity until
  // the tokenized-processor decision replaces them. Never a CVV column.
  creditCardNumber   String?
  creditCardExpMonth String?
  creditCardExpYear  String?
  creditCardZip      String?

  // The Mongo `_id` bridge for the patient collection import
  // (docs/legacy-data-mapping.md ground rules) — same role as User.legacyId.
  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // The legacy compound index, for the roster search's exact name matches.
  @@index([lastName, firstName, dateOfBirth])
  // The roster's default order: most recently seen first.
  @@index([lastVisitAt])
  @@map("patients")
}

/**
 * The medication list — one row per line item, in the order entered. Replaces
 * the free-text half of the legacy `hx` field for records edited from now on.
 */
model PatientMedication {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dose      String?
  frequency String?
  position  Int

  @@index([patientId, position])
  @@map("patient_medications")
}

/** Medication allergies — name and reaction, free text per row. */
model PatientAllergy {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  reaction  String?
  position  Int

  @@index([patientId, position])
  @@map("patient_allergies")
}

/**
 * The medical-history checklist: one row per condition the patient answered
 * "Yes" to. Absence is "No" — the checklist's vocabulary lives in contracts
 * (`PATIENT_CONDITIONS`), and the column is a plain string so replacing the
 * stub list with the final one is a vocabulary change, not a migration.
 */
model PatientCondition {
  id          String  @id @default(uuid())
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition   String
  onset       String?
  treatedBy   String?
  medicated   Boolean @default(false)
  medications String?

  @@unique([patientId, condition])
  @@map("patient_conditions")
}

/**
 * A clinic visit — the legacy `visits` collection, which was also the clinical
 * note: one free-text `notes` body, signed once by a provider. The columns here
 * are the identity, date, office, note, and signature; the legacy dispensing
 * and billing sub-documents are not modelled (docs/legacy-data-mapping.md
 * § visits).
 *
 * `dateOfService` is the legacy `created` — there was no separate visit-date
 * field. `signedByName` snapshots the signer as the legacy signature block
 * did, so a note stays attributed even when its signer's account never
 * migrated (the `npdoc` accounts the user migration refused).
 */
model Visit {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  dateOfService DateTime
  office        String?
  notes         String?
  // `Restrict`, not the default `SetNull`: the legacy system hard-deleted
  // users and left 38,047 signatures pointing at nothing. Here the delete is
  // refused while a signature references the account.
  signedById   String?
  signedBy     User?     @relation("VisitSignatures", fields: [signedById], references: [id], onDelete: Restrict)
  signedByName String?
  signedAt     DateTime?

  // Medical-director review (DIA-74, ADR 30). A note enters the queue when a
  // sampling run picks it (`sampledAt`, `sampleRunId`) and leaves it when
  // the reviewer signs off (`reviewedAt`); reviewer, comments, and timestamp
  // stay on the note, as the legacy review co-signature did.
  sampledAt      DateTime?
  sampleRunId    String?
  sampleRun      ReviewSampleRun? @relation(fields: [sampleRunId], references: [id])
  reviewedById   String?
  reviewedBy     User?     @relation("VisitReviews", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewComments String?
  reviewedAt     DateTime?

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([patientId, dateOfService])
  @@index([signedAt])
  // The queue: sampled and not yet reviewed.
  @@index([sampledAt, reviewedAt])
  @@map("visits")
}

/**
 * One run of the review sampler (DIA-74): the window of signatures it
 * considered and what it picked. The next run's window starts where this
 * one's ended, which is what makes "signed since the last run" exact rather
 * than "in the last seven days" — a late or manual run never skips a note
 * and never samples one twice.
 */
model ReviewSampleRun {
  id            String   @id @default(uuid())
  ranAt         DateTime @default(now())
  windowStart   DateTime
  windowEnd     DateTime
  eligibleCount Int
  sampledCount  Int
  /** "1 in N": 20 is the five percent the sync asked for. */
  rate          Int
  /** Null for the scheduled job; the admin who pressed "run now" otherwise. */
  triggeredById String?
  triggeredBy   User?    @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  visits        Visit[]

  @@index([windowEnd])
  @@map("review_sample_runs")
}

// --- Authentication (Better Auth core tables) ---
//
// Shapes derived from the *installed* better-auth@1.7.1 via `getAuthTables()`
// rather than from its docs — 1.7 added `account.issuer` (a synthetic
// "local:credential" for password accounts), which docs-era schemas lack.
// Reviewed by hand; the extra columns on User are ours:
//
//   role                the whole authorization vocabulary for now: a single
//                       coarse role, constrained by a native PG enum so the
//                       database refuses an invalid value no matter who writes
//   legacyId            the Mongo `_id` bridge. Every later collection
//                       migration (visits, appointments, prefrences) resolves
//                       legacy user references through this column
//   legacyRoleRaw       the original `group` value, kept for auditing the
//                       role mapping after cutover
//   isActive            legacy `isActive`; a deactivated account is refused at
//                       session verification, not deleted
//   mustChangePassword  set by the temp-credential issuance path; sign-in
//                       succeeds but every guard refuses until the password
//                       is changed

enum StaffRole {
  admin
  provider
  frontdesk
  // The administrator's access plus the note review queue (ADR 31). A role,
  // not a flag: an account has exactly one role.
  medical_director

  @@map("staff_role")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  role               StaffRole @default(frontdesk)
  legacyId           String?   @unique
  legacyRoleRaw      String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  accounts           Account[]
  signedVisits       Visit[]   @relation("VisitSignatures")
  sentIntakes        IntakeRequest[] @relation("IntakeSenders")
  reviewedIntakes    IntakeRequest[] @relation("IntakeReviewers")
  reviewedVisits     Visit[]   @relation("VisitReviews")
  triggeredSamples   ReviewSampleRun[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// --- Self-service intake (DIA-72, ADR 29) ---

enum IntakeStatus {
  sent
  submitted
  accepted
  rejected

  @@map("intake_status")
}

/**
 * One texted intake link and what came back through it. The front desk
 * creates the request (name, phone, language) and the person is texted a
 * link carrying a single-use token; only the token's hash is stored, so a
 * database read cannot mint a working link. The submission lands here as
 * JSON — the parsed, normalized form (contracts `intakeSubmissionSchema`) —
 * and becomes a patient row only when the front desk accepts it. The office
 * is the person's own choice at submission and is the queue the request
 * appears in.
 */
model IntakeRequest {
  id        String           @id @default(uuid())
  firstName String
  lastName  String
  phone     String
  language  PatientLanguage?
  tokenHash String           @unique
  expiresAt DateTime
  status    IntakeStatus     @default(sent)

  office      String?
  submission  Json?
  submittedAt DateTime?

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  createdById  String?
  createdBy    User?     @relation("IntakeSenders", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?     @relation("IntakeReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, office])
  @@map("intake_requests")
}

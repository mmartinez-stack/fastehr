{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FastEHR Base",
  "_comment": "compilerOptions only. Path-relative keys (rootDir, outDir, include, paths) resolve against THIS file's directory when inherited, so each package sets its own.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // JIT packages import raw .ts source; nothing is emitted, so the
    // extension is honest about what is actually on disk.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  }
}
